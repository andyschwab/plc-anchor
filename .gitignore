# Starknet — never commit account keys. Accounts live in ~/.starknet_accounts/ by default;
# these patterns guard against an in-repo SNCAST_ACCOUNTS_FILE. deployments/*.json is PUBLIC
# (addresses/hashes only) and IS committed.
.starknet_accounts/
*_accounts.json
starknet_accounts.json

