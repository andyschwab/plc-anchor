# Sepolia operator config — TEMPLATE. Copy to secrets/sepolia.env (gitignored) and fill in.
# Symmetric with mainnet.env.example. Push it to the two Sepolia runtimes:
#   NETWORK=sepolia scripts/secrets.sh push-fly   → the testnet console app
#   NETWORK=sepolia scripts/secrets.sh push-gh    → GitHub secrets for e2e-sepolia.yml
#
# Only these two values live here — they have no other home:

# Keyed 0.10.x sepolia endpoint (declare/estimate are rate-limited on public RPCs):
STARKNET_RPC=

# Generated once (openssl rand -hex 32) — the console fail-closes writes without it:
CONSOLE_ADMIN_TOKEN=

# NOT here: the operator PRIVATE KEY (lives only in sncast's accounts file, ~/.starknet_accounts/…)
# and the two addresses below — scripts/secrets.sh DERIVES them at push time from their canonical
# sources, so a redeploy can't leave a stale copy:
#   ANCHOR_CONTRACT_ADDRESS   ← deployments/sepolia.json
#   STARKNET_ACCOUNT_ADDRESS  ← sncast plc-sepolia
# (push-gh also sets the non-secret WITNESS_LIVE_DID repo variable if you pass it inline:
#   WITNESS_LIVE_DID=did:plc:… NETWORK=sepolia scripts/secrets.sh push-gh)
