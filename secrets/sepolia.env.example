# Sepolia operator secrets — TEMPLATE. Copy to secrets/sepolia.env (gitignored) and fill in.
# Symmetric with mainnet.env.example (same four keys) so the two networks stay identical; the only
# difference is the target: mainnet → the Fly console, sepolia → the e2e-sepolia GitHub Action
# (scripts/secrets.sh push-fly vs push-gh, Phase 5). The operator PRIVATE KEY is NOT here — it
# lives only in sncast's accounts file (~/.starknet_accounts/…).
#
# Only STARKNET_RPC and CONSOLE_ADMIN_TOKEN have no other home. The two *_ADDRESS values are
# copies of canonical sources — for LOCAL runs you don't need them: `scripts/ingest.sh` resolves
# both from those sources automatically. They are pinned here only for the deployed console/CI,
# which can't read deployments/*.json or the sncast file at runtime. Re-copy them after any deploy.

# Keyed 0.10.x sepolia endpoint (declare/estimate are rate-limited on public RPCs):
STARKNET_RPC=

# Copied from deployments/sepolia.json .contractAddress after each deploy (canonical: that file):
ANCHOR_CONTRACT_ADDRESS=

# The plc-sepolia operator address from the sncast accounts file (canonical: that file):
STARKNET_ACCOUNT_ADDRESS=

# Generated once (openssl rand -hex 32) — the console fail-closes writes without it:
CONSOLE_ADMIN_TOKEN=
