# Mainnet operator secrets — TEMPLATE. Copy to secrets/mainnet.env (gitignored) and fill in.
# The real file is the single local source of truth for the DEPLOYED runtime (Fly console + CI);
# it is never pushed to GitHub. The operator PRIVATE KEY is NOT here — it lives only in sncast's
# accounts file (~/.starknet_accounts/…); scripts/secrets.sh (Phase 5) reads it from there.
#
# Only STARKNET_RPC and CONSOLE_ADMIN_TOKEN have no other home. The two *_ADDRESS values are
# copies of canonical sources — for LOCAL runs you don't need them: `scripts/ingest.sh` resolves
# both from those sources automatically. They are pinned here only for the deployed console/CI,
# which can't read deployments/*.json or the sncast file at runtime. Re-copy them after any deploy.

# Keyed 0.10.x mainnet endpoint (declare/estimate are rate-limited on public RPCs):
STARKNET_RPC=

# Copied from deployments/mainnet.json .contractAddress after each deploy (canonical: that file):
ANCHOR_CONTRACT_ADDRESS=

# The plc-mainnet operator address from the sncast accounts file (canonical: that file):
STARKNET_ACCOUNT_ADDRESS=

# Generated once (openssl rand -hex 32) — the console fail-closes writes without it:
CONSOLE_ADMIN_TOKEN=
